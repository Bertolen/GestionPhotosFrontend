# Configuration pour le déploiement Docker sur Raspberry Pi 4
# Copiez ce fichier en .env et modifiez les valeurs

# Nom de l'image Docker
IMAGE_NAME=gestion-photos-frontend
IMAGE_TAG=latest

# Configuration Raspberry Pi
RASPBERRY_IP=192.168.1.100
RASPBERRY_USER=pi
RASPBERRY_SSH_PORT=22

# Port sur lequel l'application sera accessible sur la Raspberry
RASPBERRY_DOCKER_PORT=8080
